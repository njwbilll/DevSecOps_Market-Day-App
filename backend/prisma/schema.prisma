generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MAHASISWA
  MERCHANT
  ADMIN
}

enum TxType {
  TOPUP
  PAYMENT
}

enum TxStatus {
  PENDING
  SUCCESS
  REJECTED
}

// D1 Akun & Role
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  name         String
  passwordHash String
  role         Role
  merchantCode String?  @unique
  createdAt    DateTime @default(now())

  wallet     Wallet?
  studentTx  Transaction[] @relation("StudentTx")
  merchantTx Transaction[] @relation("MerchantTx")
  verifiedTx Transaction[] @relation("VerifierTx")
}

// D2 Dompet & Transaksi (saldo hanya disimpan di sini)
model Wallet {
  id      String @id @default(uuid())
  userId  String @unique
  balance Int    @default(0)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id           String    @id @default(uuid())
  receiptNo    String    @unique
  type         TxType
  status       TxStatus
  amount       Int
  method       String?
  note         String?
  adminNote    String?
  proofPath    String?
  studentId    String
  merchantId   String?
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  student  User  @relation("StudentTx", fields: [studentId], references: [id])
  merchant User? @relation("MerchantTx", fields: [merchantId], references: [id])
  verifier User? @relation("VerifierTx", fields: [verifiedById], references: [id])

  @@index([studentId, createdAt])
  @@index([merchantId, createdAt])
  @@index([type, status])
}
