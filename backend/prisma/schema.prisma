generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  name         String
  passwordHash String
  role         Role
  merchantCode String?       @unique
  createdAt    DateTime      @default(now())
  merchantTx   Transaction[] @relation("MerchantTx")
  studentTx    Transaction[] @relation("StudentTx")
  verifiedTx   Transaction[] @relation("VerifierTx")
  wallet       Wallet?
}

model Wallet {
  id      String @id @default(uuid())
  userId  String @unique
  balance Int    @default(0)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id           String    @id @default(uuid())
  receiptNo    String    @unique
  type         TxType
  status       TxStatus
  amount       Int
  method       String?
  reference    String?   @unique
  paymentCode  String?
  note         String?
  adminNote    String?
  proofPath    String?
  studentId    String
  merchantId   String?
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  merchant     User?     @relation("MerchantTx", fields: [merchantId], references: [id])
  student      User      @relation("StudentTx", fields: [studentId], references: [id])
  verifier     User?     @relation("VerifierTx", fields: [verifiedById], references: [id])

  @@index([studentId, createdAt])
  @@index([merchantId, createdAt])
  @@index([type, status])
}

model WebhookLog {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  ip             String
  signatureValid Boolean
  reference      String?
  rawBody        String
  result         String

  @@index([createdAt])
  @@index([reference])
}

model AdminLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  adminId   String
  action    String
  detail    String?
  ip        String?

  @@index([createdAt])
}

enum Role {
  MAHASISWA
  MERCHANT
  ADMIN
}

enum TxType {
  TOPUP
  PAYMENT
}

enum TxStatus {
  PENDING
  SUCCESS
  REJECTED
}
