# Salin menjadi .env lalu ganti semua nilai di bawah
POSTGRES_USER=marketday
POSTGRES_PASSWORD=ganti_dengan_password_database_yang_kuat
POSTGRES_DB=marketday

# Minimal 24 karakter acak. Contoh membuat: openssl rand -hex 32
JWT_SECRET=ganti_dengan_string_acak_minimal_24_karakter
JWT_EXPIRES_IN=2h

# Akun awal (dibuat sekali saat pertama kali dijalankan)
SEED_ADMIN_PASSWORD=GantiPasswordAdmin123
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=Demo12345

# Top up otomatis. sandbox = ada tombol simulasi pembayaran. live = hanya dari payment gateway.
PAYMENT_MODE=sandbox
# Kunci tanda tangan webhook (minimal 16 karakter acak). Contoh: openssl rand -hex 24
PAYMENT_WEBHOOK_SECRET=ganti_dengan_string_acak_minimal_16_karakter
